---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { absoluteUrl, siteMeta } from '../lib/site';

interface Props {
  title: string;
  description: string;
  ogType?: 'website' | 'article';
  updated?: Date;
  noindex?: boolean;
}

const {
  title,
  description,
  ogType = 'website',
  updated,
  noindex = false,
} = Astro.props;

const pageTitle = title === siteMeta.name ? siteMeta.name : `${title} | ${siteMeta.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogUrl = canonical.href;
const ogImage = absoluteUrl('/favicon.svg', Astro.site);
---

<!doctype html>
<html lang={siteMeta.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:locale" content={siteMeta.locale} />
    <meta property="og:site_name" content={siteMeta.name} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {updated && <meta property="article:modified_time" content={updated.toISOString()} />}
    <slot name="head" />
  </head>
  <body>
    <Header currentPath={Astro.url.pathname} />
    <main id="main" class="page-wrap">
      <slot />
    </main>
    <Footer />
  </body>
</html>
