# Optional canonical origin (sitemap, robots.txt, Open Graph, canonical tags).
# Must be an absolute URL (https://…). Leave unset on Vercel to use the
# deployment host automatically. Empty or relative values are ignored.
# PUBLIC_SITE_URL=https://your-domain.example

# Amazon Associates Japan tracking ID (associate tag). Baked in at build time.
# Default is wasshoi22451-22. After changing this on Vercel, Redeploy / rebuild.
# PUBLIC_AMAZON_ASSOCIATE_TAG=wasshoi22451-22

# Google AdSense (leave unset until the site is approved). Baked in at build time.
# Do not paste guessed or example publisher IDs — any non-digit placeholder keeps stub slots.
# After AdSense approval, copy the real ca-pub-… client from the AdSense UI, then Redeploy.
# PUBLIC_ADSENSE_CLIENT=
# Optional display ad unit IDs (digits only) per article placement:
# PUBLIC_ADSENSE_SLOT_TOP=
# PUBLIC_ADSENSE_SLOT_MID=
# PUBLIC_ADSENSE_SLOT_BOTTOM=
